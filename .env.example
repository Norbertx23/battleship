# Skopiuj jako .env i uzupelnij wartosciami. Plik .env NIGDY nie trafia do repo.
#
# UWAGA: nie ustawiaj tu DATABASE_URL, jesli uzywasz docker-compose z deploy/.
# Compose wstrzykuje ten plik do kontenera przez env_file, a ustawiony
# DATABASE_URL nadpisalby polaczenie budowane z POSTGRES_* + DB_HOST.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Opcjonalne - tylko dla uruchomienia backendu poza Dockerem (lokalny dev):
# DB_HOST=localhost
# DB_PORT=5432
# DATABASE_URL=sqlite:///./dev.db

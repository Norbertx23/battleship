[Unit]
Description=Battleship - pull nowych obrazow z GHCR i deploy
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=norbert
Group=docker
Environment=HOME=/home/norbert
Environment=DOCKER_CONFIG=/home/norbert/.docker
ExecStart=/opt/stacks/battleship/update.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
